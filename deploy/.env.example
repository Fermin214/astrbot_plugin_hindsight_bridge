# Copy to .env, chmod 600 .env, and fill every credential before starting.
# Generate each secret independently with: openssl rand -hex 32
POSTGRES_PASSWORD=
HINDSIGHT_API_TENANT_API_KEY=
# Browser login only; keep independent of the data API and model provider keys.
HINDSIGHT_CP_ACCESS_KEY=
# Keep this identity on recreate; different simultaneous workers need different IDs.
HINDSIGHT_API_WORKER_ID=astrbot-hindsight-worker-1
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:1.1.0-slim
HINDSIGHT_CLIENT_NETWORK=astrbot_hindsight
# Host loopback ports only; container API/CP ports stay 8888/9999.
HINDSIGHT_API_PORT=8888
HINDSIGHT_UI_PORT=9999

# Example remote providers. Change them to match your own accounts.
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_MODEL=deepseek-v4-flash
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_BASE_URL=https://api.deepseek.com
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-v4
HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1024
HINDSIGHT_API_EMBEDDINGS_OPENAI_BATCH_SIZE=10
# "rrf" avoids a third model/API dependency; remote reranking can be configured later.
HINDSIGHT_API_RERANKER_PROVIDER=rrf
